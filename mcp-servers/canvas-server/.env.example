# Canvas LMS MCP Server Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# CANVAS INSTANCE URL
# =============================================================================
# For UNR WebCampus Beta testing:
CANVAS_URL=https://unr.beta.instructure.com

# For production (requires Security/IT Governance review):
# CANVAS_URL=https://webcampus.unr.edu

# =============================================================================
# CANVAS API TOKEN (Fallback for development/testing)
# =============================================================================
# Personal Access Token - used as fallback if no runtime OAuth token provided
# Get this from: Canvas → Account → Settings → "+ New Access Token"
# 
# How this works:
# 1. Agent provides OAuth tokens at runtime via /tmp/agendaai_canvas_runtime_token.json
# 2. If runtime token file exists, it takes priority
# 3. If no runtime token, falls back to this static CANVAS_TOKEN
# 4. Static token is useful for single-user testing and development

CANVAS_TOKEN=your_canvas_api_token_here

# =============================================================================
# CANVAS OAUTH CREDENTIALS (For Agent Integration)
# =============================================================================
# These are configured in backend/.env and used by the agent
# The agent writes runtime tokens to /tmp/agendaai_canvas_runtime_token.json
# which this MCP server automatically loads
# 
# Developer Key Contact: capollon@unr.edu
# Credentials: https://share.1password.com/s#JXCdcwSSAxGSnW040hq1Bp07X_JCszjDum26OMjC3OA

CANVAS_CLIENT_ID=your_canvas_client_id_here
CANVAS_CLIENT_SECRET=your_canvas_client_secret_here

# =============================================================================
# UNR BETA TESTING ACCOUNT
# =============================================================================
# Test student account credentials (for manual testing):
# Username: cs426project1@team743740.testinator.email
# Password: Available at https://share.1password.com/s#4jwABiBxjABuXxwWk0d7A69mEL1zpY4V4VQvshuRInE
# Login at: https://unr.beta.instructure.com/login/canvas
# 
# Important Beta Environment Notes:
# - Beta resets every Saturday with fresh Production data
# - All test data created in Beta is wiped weekly
# - Must login to Canvas Beta manually before OAuth (Beta quirk)
# - Developer key is READ ONLY, test environment only

CANVAS_TEST_EMAIL=cs426project1@team743740.testinator.email
CANVAS_TEST_PASSWORD=see_1password_link_above
