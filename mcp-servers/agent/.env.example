# =============================================================================
# AgendaAI MCP Agent Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Place this file in the mcp-servers/agent/ directory

# =============================================================================
# GOOGLE GEMINI AI CONFIGURATION (REQUIRED)
# =============================================================================
# Google Gemini API Key for AI agent functionality
# How to get this:
# 1. Go to: https://aistudio.google.com/app/apikey
# 2. Sign in with your Google account
# 3. Click "Create API Key" or "Get API Key"
# 4. Select an existing Google Cloud project or create a new one
# 5. Copy the generated API key

GOOGLE_API_KEY=your_google_gemini_api_key_here

# =============================================================================
# DATABASE CONFIGURATION (MUST MATCH BACKEND)
# =============================================================================
# PostgreSQL connection string - MUST be the same as backend/.env
# Format: postgresql+psycopg://username:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://agendaai:agendaai@localhost:5432/agendaai

# =============================================================================
# AUTHENTICATION & SECURITY (MUST MATCH BACKEND)
# =============================================================================
# Secret key for JWT token encryption - MUST be the same as backend/.env
# This is critical for validating user sessions across services
SECRET_KEY=your_secret_key_here_change_this_in_production

# =============================================================================
# AWS COGNITO CONFIGURATION (MUST MATCH BACKEND)
# =============================================================================
# These values must match your backend/.env configuration
# Copy them exactly from your backend environment file

COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=your_user_pool_id_here
COGNITO_APP_CLIENT_ID=your_app_client_id_here

# =============================================================================
# CANVAS CONFIGURATION (Optional - for Canvas LMS integration)
# =============================================================================
# Canvas instance URL
CANVAS_URL=https://canvas.instructure.com

# =============================================================================
# GOOGLE OAUTH CONFIGURATION (MUST MATCH BACKEND)
# =============================================================================
# These values must match your backend/.env configuration
# Required for Google Calendar and Gmail MCP server integration

GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# =============================================================================
# NOTES
# =============================================================================
# IMPORTANT: Values marked "MUST MATCH BACKEND" need to be identical to your
# backend/.env file for proper authentication and service integration.
#
# The agent runs on port 8001 by default (configured in tasks.json)
# Backend runs on port 8000
# Frontend runs on port 3000

