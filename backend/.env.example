# =============================================================================
# AgendaAI Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Place this file in the backend/ directory

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql+psycopg://username:password@host:port/database_name
# Default values match the Docker Compose setup in ../infra/docker-compose.yaml
DATABASE_URL=postgresql+psycopg://agendaai:agendaai@localhost:5432/agendaai

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Secret key for JWT token encryption (REQUIRED - generate a secure random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_change_this_in_production

# JWT token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application environment
ENVIRONMENT=development

# =============================================================================
# AWS COGNITO CONFIGURATION (REQUIRED for user authentication)
# =============================================================================
# How to get these values:
# 1. Go to AWS Console: https://console.aws.amazon.com/cognito
# 2. Select your User Pool (or create one if needed)
# 3. COGNITO_REGION: Your AWS region (e.g., us-east-2)
# 4. COGNITO_USER_POOL_ID: Found in "User pool overview" section (e.g., us-east-2_xxxxxxxxx)
# 5. COGNITO_APP_CLIENT_ID: Go to "App integration" → "App clients" → Select your app client

COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=your_user_pool_id_here
COGNITO_APP_CLIENT_ID=your_app_client_id_here

# =============================================================================
# CANVAS CONFIGURATION (Optional - for Canvas LMS integration)
# =============================================================================
# Canvas LMS instance URL
# For UNR Beta testing environment:
CANVAS_URL=https://unr.beta.instructure.com
# For production: https://webcampus.unr.edu (requires Security/IT review)

# Canvas OAuth (REQUIRED for multi-user Canvas integration)
# How to get these values for UNR Beta:
# 1. Contact: capollon@unr.edu (Chantilly Apollon, Learning Systems Administrator)
# 2. Request a Canvas Developer Key for OAuth integration
# 3. Provide your redirect URI: http://localhost:8000/oauth/canvas/callback
# 4. Developer key credentials available at:
#    https://share.1password.com/s#JXCdcwSSAxGSnW040hq1Bp07X_JCszjDum26OMjC3OA
#
# Important Notes:
# - Beta credentials are READ ONLY and test environment only
# - Beta environment resets every Saturday (data is wiped)
# - OAuth scope used: url:GET|/api/v1/courses (read-only course access)
# - Redirect URI must match exactly what's configured in Canvas developer key

CANVAS_CLIENT_ID=your_canvas_client_id_here
CANVAS_CLIENT_SECRET=your_canvas_client_secret_here
CANVAS_REDIRECT_URI=http://localhost:8000/oauth/canvas/callback

# Test Account for Beta (optional, for manual testing):
# Username: cs426project1@team743740.testinator.email
# Password: Available in 1Password link above
# Note: Must login to Canvas Beta manually before using OAuth (Beta environment quirk)

# =============================================================================
# GOOGLE OAUTH CONFIGURATION (REQUIRED for Calendar and Gmail)
# =============================================================================
# How to get these values:
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create a new OAuth 2.0 Client ID (or use existing one)
# 3. Application type: Web application
# 4. Add authorized redirect URIs:
#    - http://localhost:8000/oauth/google-calendar/callback
#    - http://localhost:8000/oauth/gmail/callback
# 5. Enable required APIs:
#    - Google Calendar API: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
#    - Gmail API: https://console.cloud.google.com/apis/library/gmail.googleapis.com

GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google-calendar/callback
GMAIL_REDIRECT_URI=http://localhost:8000/oauth/gmail/callback

# =============================================================================
# AMAZON OAUTH CONFIGURATION (Optional - for Amazon SSO login)
# =============================================================================
# How to get these values:
# 1. Go to: https://developer.amazon.com/loginwithamazon/console/site/lwa/overview.html
# 2. Create a new Security Profile
# 3. Add allowed return URLs:
#    - https://YOUR_COGNITO_DOMAIN.auth.YOUR_REGION.amazoncognito.com/oauth2/idpresponse
# 4. Get Client ID and Client Secret from the security profile
# 5. Configure in AWS Cognito:
#    - User Pool → Sign-in experience → Federated identity providers → Add Amazon
#    - Enable Amazon in App client settings

AMAZON_CLIENT_ID=your_amazon_client_id_here
AMAZON_CLIENT_SECRET=your_amazon_client_secret_here
AMAZON_REDIRECT_URI=http://localhost:8000/oauth/amazon/callback

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Frontend URL for OAuth redirects and CORS
# Used when redirecting users after OAuth flow completes
FRONTEND_URL=http://localhost:3000

# =============================================================================
# OPTIONAL: DEVELOPMENT SETTINGS
# =============================================================================
# Backend server port (default: 8000)
# BACKEND_PORT=8000

# Debug mode (default: False)
# DEBUG=True
