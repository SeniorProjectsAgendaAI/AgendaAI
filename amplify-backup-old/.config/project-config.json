{
  "providers": [
    "awscloudformation"
  ],
  "projectName": "ignore",
  "version": "3.1",
  "frontend": "javascript",
  "javascript": {
    "framework": "none",
    "config": {
      "SourceDir": "frontend/src",
      "DistributionDir": "frontend/build",
      "BuildCommand": "cd frontend && npm run build",
      "StartCommand": "cd frontend && npm start"
    }
  }
}