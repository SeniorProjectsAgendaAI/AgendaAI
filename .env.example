# =============================================================================
# AgendaAI Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# This file contains all environment variables needed to run AgendaAI with AI features

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql+psycopg://username:password@host:port/database_name
# Default values match the Docker Compose setup in infra/docker-compose.yaml
DATABASE_URL=postgresql+psycopg://agendaai:agendaai@localhost:5432/agendaai

# =============================================================================
# BACKEND AUTHENTICATION & SECURITY
# =============================================================================
# Secret key for JWT token encryption (generate a secure random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here_change_this_in_production

# JWT token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Cognito Configuration (if using AWS Cognito for authentication)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=your_cognito_user_pool_id_here
COGNITO_APP_CLIENT_ID=your_cognito_app_client_id_here

# =============================================================================
# GOOGLE OAUTH & API CONFIGURATION
# =============================================================================
# Google OAuth Client ID and Secret
# Get these from: https://console.cloud.google.com/apis/credentials
# Required for Gmail and Google Calendar integration
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google OAuth Redirect URI (must match what's configured in Google Console)
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google-calendar/callback

# Google AI API Key (Gemini)
# Get this from: https://aistudio.google.com/apikey
# Required for AI agent features
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# CANVAS LMS CONFIGURATION
# =============================================================================
# Your Canvas instance URL (e.g., https://canvas.instructure.com)
# Or your school's Canvas URL
CANVAS_URL=https://canvas.instructure.com

# Your Canvas API token
# Get this from: Canvas → Account → Settings → "+ New Access Token"
CANVAS_TOKEN=your_canvas_api_token_here

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Frontend URL for OAuth redirects and CORS
FRONTEND_URL=http://localhost:3000

# =============================================================================
# GOOGLE TOKEN PATHS (for MCP servers)
# =============================================================================
# These are used by the MCP servers to store OAuth tokens
# Default paths are relative to each MCP server directory
GMAIL_TOKEN_PATH=gmail_token.json
GCAL_TOKEN_PATH=gcal_token.json

# =============================================================================
# OPTIONAL: DEVELOPMENT SETTINGS
# =============================================================================
# Backend server port (default: 8000)
# BACKEND_PORT=8000

# Frontend development server port (default: 3000)
# PORT=3000

# Debug mode (default: False in production)
# DEBUG=True
